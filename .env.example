# Same Supabase project as Frescopa (Project Settings → API) — new tables live in the
# hcp_* namespace, unrelated to the Frescopa retail tables.
SUPABASE_URL=https://uxlccvzhuwzwzrmqunml.supabase.co
SUPABASE_ANON_KEY=

# HTTP MCP (npm run start:http) — for remote clients
# Different port from Frescopa's HTTP server (3000) so both can run locally at once.
PORT=3100
HOST=0.0.0.0
# Set a long random secret; clients send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
