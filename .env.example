# HCP Neon project: pooled connection string for the MCP runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# HTTP MCP (npm run start:http) — for remote clients
# Different port from Frescopa's HTTP server (3000) so both can run locally at once.
PORT=3100
HOST=0.0.0.0
# Set a long random secret; clients send: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=
